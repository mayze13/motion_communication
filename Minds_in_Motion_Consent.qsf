  "SurveyElements": [
    {
      "SurveyID": "SV_MindsInMotionConsent",
      "Element": "SQ",
      "PrimaryAttribute": "QID1",
      "SecondaryAttribute": "<h3>Minds in Motion consent form</h3><p>UCL Research Ethics Committee, Project ID EP/2024/020. Minds",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<h3>Minds in Motion consent form</h3><p>UCL Research Ethics Committee, Project ID EP/2024/020. Minds in Motion is a sub-study under that approval.</p><p><b>Please complete this form after you have read the Information Sheet, or listened to an explanation about the research.</b> The person organising the research must explain the project to you before you agree to take part. If you have any questions arising from the Information Sheet or the explanation already given to you, please ask the researcher before you decide whether to join in.</p><p>You will be emailed a copy of this completed form to keep and refer to at any time.</p><p style='font-size:0.9em'>Researcher: James Moultrie (james.moultrie.25@ucl.ac.uk) &middot; Principal researcher: Prof Hugo Spiers (h.spiers@ucl.ac.uk) &middot; UCL Data Protection Officer: Lee Shailer (data-protection@ucl.ac.uk)</p>",
        "QuestionType": "DB",
        "Selector": "TB",
        "Configuration": {
          "QuestionDescriptionOption": "UseText"
        },
        "Validation": {
          "Settings": {
            "Type": "None"
          }
        },
        "QuestionID": "QID1",
        "DataExportTag": "intro",
        "QuestionDescription": "<h3>Minds in Motion consent form</h3><p>UCL Research Ethics Committee, Project ID EP/2024/020. Minds",
        "Language": [],
        "NextChoiceId": 1,
        "NextAnswerId": 1
      }
    },
    {
      "SurveyID": "SV_MindsInMotionConsent",
